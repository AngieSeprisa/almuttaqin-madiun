# Konfigurasi MQTT Broker
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_TAP=presensi/santri/tap
MQTT_TOPIC_RESPONSE=presensi/santri/response
MQTT_CLIENT_ID=Python_Presensi_Backend

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_muttaqin
DB_USER=root
DB_PASSWORD=

# Pengaturan Perilaku Presensi
DEBOUNCE_SECONDS=4
ALLOW_DUPLICATE_TAP_PER_DAY=false
